---
import Base from './Base.astro';
import { SITE, business, services } from '../config/site';
const { title, description, eyebrow = 'MB AUTOS', h1, intro, image, schemaType = 'AutoRepair', breadcrumbs = [] } = Astro.props;
const autoRepairSchema = {
  '@context':'https://schema.org','@type':schemaType,'name':business.name,'url':SITE,
  'address':{'@type':'PostalAddress','streetAddress':business.street,'addressLocality':business.locality,'addressRegion':business.region,'postalCode':business.postcode,'addressCountry':business.country},
  'geo':{'@type':'GeoCoordinates','latitude':business.geo.lat,'longitude':business.geo.lng},
  'telephone':business.phone,'email':business.email,'priceRange':business.priceRange,
  'areaServed':business.locality,
  'openingHoursSpecification':business.hours.filter(h=>h.opens).map(h=>({'@type':'OpeningHoursSpecification','dayOfWeek':`https://schema.org/${h.day}`,'opens':h.opens,'closes':h.closes})),
  'hasOfferCatalog':{'@type':'OfferCatalog','name':'Garage services','itemListElement':services.map(s=>({'@type':'Offer','itemOffered':{'@type':'Service','name':s.title,'url':new URL('/'+s.slug,SITE).href}}))}
};
const breadcrumbSchema = breadcrumbs.length ? {'@context':'https://schema.org','@type':'BreadcrumbList','itemListElement':breadcrumbs.map((b,i)=>({'@type':'ListItem','position':i+1,'name':b.name,'item':new URL(b.path,SITE).href}))} : null;
---
<Base {title} {description} {image}>
  <slot name="head" slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(autoRepairSchema)}></script>
  {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>}
  <header class="sticky top-0 z-40 border-b border-[#3b352b] bg-[#0b0b0a]/95 backdrop-blur">
    <div class="container flex min-h-16 items-center justify-between gap-4">
      <a href="/" class="flex shrink-0 items-center" aria-label="MB Autos home"><img src="/mb-autos.png" alt="MB Autos" width="170" height="99" class="h-auto w-[125px] sm:w-[145px]" /></a>
      <nav class="hidden items-center gap-5 text-sm font-semibold lg:flex" aria-label="Primary">
        <a href="/mot-testing">MOTs</a><a href="/ev-servicing">EVs</a><a href="/bodywork-paintwork">Bodywork</a><a href="/servicing-diagnostics">Servicing</a><a href="/about">About</a><a href="/contact">Contact</a>
      </nav>
      <div class="hidden items-center gap-2 md:flex">
        <a class="btn btn-secondary py-2.5" href={`tel:${business.phone.replaceAll(' ','')}`}>Call {business.phone}</a>
        <a class="btn btn-primary py-2.5" href="/book">Book online</a>
      </div>
      <button id="menu-button" class="rounded-md border border-[#655a48] px-3 py-2 lg:hidden" aria-expanded="false" aria-controls="mobile-menu">Menu</button>
    </div>
    <div id="mobile-menu" class="hidden border-t border-[#3b352b] bg-[#0b0b0a] lg:hidden">
      <nav class="container grid gap-2 py-4 font-semibold" aria-label="Mobile primary">
        <a class="py-2" href="/mot-testing">MOTs</a><a class="py-2" href="/ev-servicing">EV servicing</a><a class="py-2" href="/bodywork-paintwork">Bodywork & paint</a><a class="py-2" href="/engine-rebuilds-timing-belts">Engines & timing belts</a><a class="py-2" href="/servicing-diagnostics">Servicing & diagnostics</a><a class="py-2" href="/brakes-tyres-clutches">Brakes, tyres & clutches</a><a class="py-2" href="/about">About</a><a class="py-2" href="/contact">Contact</a><a class="py-2" href="/book">Book online</a>
      </nav>
    </div>
  </header>
  <main id="main">
    <section class="section grid-lines border-b border-zinc-800">
      <div class="container grid gap-8 lg:grid-cols-[1.2fr_.8fr] lg:items-end">
        <div>
          <p class="mb-3 text-sm font-bold uppercase tracking-[.2em] text-[var(--accent)]">{eyebrow}</p>
          <h1 class="max-w-4xl text-5xl font-bold uppercase leading-[.95] sm:text-6xl lg:text-7xl">{h1}</h1>
          <p class="mt-5 max-w-2xl text-lg leading-8 text-zinc-300">{intro}</p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a class="btn btn-primary" href="/book">Book online</a>
            <a class="btn btn-secondary" href={`tel:${business.phone.replaceAll(' ','')}`}>Call now</a>
          </div>
          <p class="mt-3 text-sm font-semibold text-zinc-400">Saturday by appointment. Mon–Fri 8:30am–5:30pm.</p>
        </div>
        <div class="card overflow-hidden">
          <img src={image} alt="" width="1600" height="1000" class="h-full w-full object-cover" loading="eager" decoding="async" />
        </div>
      </div>
    </section>
    <slot />
  </main>
  <footer class="border-t border-[#3b352b] bg-[#080807]">
    <div class="container grid gap-8 py-12 sm:grid-cols-2 lg:grid-cols-4">
      <div><a href="/" aria-label="MB Autos home"><img src="/mb-autos.png" alt="MB Autos" width="190" height="110" class="h-auto w-[150px]" /></a><p class="mt-3 text-sm text-zinc-400">MOT centre and repair garage in Mossley. {business.yearsExperience} experience.</p></div>
      <div><h2 class="font-display text-lg uppercase">Visit</h2><p class="mt-3 text-sm leading-6 text-zinc-400">{business.street}<br/>{business.locality}<br/>{business.region}<br/>{business.postcode}</p></div>
      <div><h2 class="font-display text-lg uppercase">Opening</h2><p class="mt-3 text-sm leading-6 text-zinc-400">Mon–Fri 8:30am–5:30pm<br/>Saturday by appointment<br/>Sunday closed</p></div>
      <div><h2 class="font-display text-lg uppercase">Call / email</h2><p class="mt-3 text-sm leading-6"><a class="underline decoration-zinc-600 underline-offset-4" href={`tel:${business.phone.replaceAll(' ','')}`}>{business.phone}</a><br/><a class="underline decoration-zinc-600 underline-offset-4" href={`mailto:${business.email}`}>{business.email}</a></p></div>
    </div>
    <div class="border-t border-[#3b352b]"><div class="container py-5 text-xs text-[#8f897d]">© {new Date().getFullYear()} MB Autos. Unit 3, Camden Street, Mossley, OL5 9BD.</div></div>
  </footer>
  <script is:inline>
    const b=document.getElementById('menu-button'),m=document.getElementById('mobile-menu');
    b?.addEventListener('click',()=>{const open=b.getAttribute('aria-expanded')==='true';b.setAttribute('aria-expanded',String(!open));m?.classList.toggle('hidden',open)});
  </script>
</Base>
