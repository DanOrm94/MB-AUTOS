---
import Page from '../layouts/Page.astro';
import CTA from '../components/CTA.astro';
import FAQ from '../components/FAQ.astro';
import { business, services, locations } from '../config/site';
import reviews from '../data/reviews.json';
import garage from '../assets/garage-exterior-placeholder.svg';
import workshop from '../assets/garage-workshop-placeholder.svg';
const description='MB Autos in Mossley: Class 4 & 7 MOTs, EV servicing, repairs, bodywork, diagnostics and more. 30+ years local garage experience.';
const reviewSchema = !reviews.some(r=>r.placeholder) && reviews.length ? {'@context':'https://schema.org','@type':'AggregateRating','ratingValue':business.ratingValue,'reviewCount':business.reviewCount} : null;
---
<Page title="MB Autos | MOTs, repairs & servicing in Mossley" {description} h1="Proper garage work. No faff." intro="MOTs, repairs, EV servicing and bodywork from a local workshop in Mossley with 30+ years’ experience. Honest advice, sensible repairs and getting your car sorted today." image={garage.src}>
  {reviewSchema && <script type="application/ld+json" set:html={JSON.stringify(reviewSchema)} />}
  <section class="border-b border-zinc-800 bg-[#151818]">
    <div class="container grid gap-8 py-12 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <p class="text-sm font-bold uppercase tracking-[.2em] text-[var(--accent)]">MOTs from {business.motPriceDisplay} · Class 4 & 7</p>
        <h2 class="mt-2 max-w-3xl text-4xl uppercase sm:text-5xl">Book the MOT. Get a free £30 diagnostic health check on request.</h2>
      </div>
      <div class="flex flex-col justify-end gap-3 lg:items-end"><a class="btn btn-primary" href="https://mbautos.co.uk/book/">Book online</a><p class="text-sm font-semibold text-zinc-400">Saturday by appointment</p></div>
    </div>
  </section>
  <section class="section"><div class="container"><div class="mb-8 max-w-2xl"><p class="text-sm font-bold uppercase tracking-[.2em] text-[var(--accent)]">What we do</p><h2 class="mt-2 text-4xl uppercase">One workshop. Plenty sorted.</h2></div><div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">{services.map(s=><a class="card group p-6 hover:border-zinc-500" href={`/${s.slug}`}><p class="text-sm font-bold text-[var(--accent)]">MB AUTOS</p><h3 class="mt-2 text-2xl uppercase">{s.title}</h3><p class="mt-3 text-zinc-400">{s.short}</p><p class="mt-5 font-bold group-hover:underline">{s.price ?? 'See service'} →</p></a>)}</div></div></section>
  <section class="section border-y border-zinc-800 bg-[#0d0f0f]"><div class="container grid gap-10 lg:grid-cols-2 lg:items-center"><div><p class="text-sm font-bold uppercase tracking-[.2em] text-[var(--accent)]">Why MB Autos</p><h2 class="mt-2 text-4xl uppercase">30+ years of fixing cars without making a drama of it.</h2><div class="mt-6 grid gap-4 sm:grid-cols-2"><div class="card p-5"><strong>5.0 stars</strong><p class="mt-1 text-sm text-zinc-400">13 Google reviews</p></div><div class="card p-5"><strong>EV qualified</strong><p class="mt-1 text-sm text-zinc-400">IMI Level 4 EV technician</p></div><div class="card p-5"><strong>Approved test station</strong><p class="mt-1 text-sm text-zinc-400">Class 4 & 7 MOTs</p></div><div class="card p-5"><strong>Free check</strong><p class="mt-1 text-sm text-zinc-400">£30 diagnostic health check with MOT on request</p></div></div></div><div class="card overflow-hidden"><img src={workshop.src} alt="Placeholder for MB Autos workshop photo" width="1600" height="1000" loading="lazy" class="w-full object-cover" /></div></div></section>
  <section class="section"><div class="container grid gap-6 md:grid-cols-2 lg:grid-cols-4">{locations.map(l=><div class="card p-5"><h3 class="text-2xl uppercase">{l.name}</h3><p class="mt-2 text-sm leading-6 text-zinc-400">{l.copy}</p></div>)}</div></section>
  <section class="section bg-[#151818]"><div class="container grid gap-8 lg:grid-cols-2"><div><p class="text-sm font-bold uppercase tracking-[.2em] text-[var(--accent)]">Questions</p><h2 class="mt-2 text-4xl uppercase">Straight answers.</h2></div><FAQ /></div></section>
  <CTA />
</Page>
