  <section class="section"><div class="container grid gap-4 sm:grid-cols-2 lg:grid-cols-4">{['Brakes','Tyres','Clutches','Steering & suspension'].map(x=><div class="card p-6"><h2 class="text-2xl uppercase">{x}</h2><p class="mt-3 text-sm text-zinc-400">From worn components to a job spotted at MOT, we can inspect and repair the problem.</p></div>)}</div></section><CTA />
</Page>
