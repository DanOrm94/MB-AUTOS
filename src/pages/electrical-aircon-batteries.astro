---
import Page from '../layouts/Page.astro';
import CTA from '../components/CTA.astro';
import { business } from '../config/site';
import diagnostics from '../assets/garage-exterior-placeholder.svg';

const description='Electrical repairs, batteries, air conditioning, exhausts, key programming and remaps from MB Autos in Mossley.';
const breadcrumbs=[{name:'Home',path:'/'},{name:'Electrical, A/C & more',path:'/electrical-aircon-batteries'}];
---
<Page title="Electrical, A/C & More | MB Autos Mossley" {description} h1="Electrical, A/C & more." intro="Electrical faults, batteries, air conditioning, exhausts, key programming and remaps from our Mossley workshop." image={diagnostics.src} breadcrumbs={breadcrumbs}>
  <section class="section">
    <div class="container grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {[
        ['Electrical diagnostics','Warning lights, electrical faults and fault finding when something is not behaving as it should.'],
        ['Batteries','Battery testing, replacement and related starting or charging issues.'],
        ['Air conditioning','Air-con checks and repairs to help keep the cabin working properly.'],
        ['Exhausts','Exhaust repairs and replacement work where needed.'],
        ['Key programming','Key and vehicle programming for supported vehicles.'],
        ['Remaps','ECU remapping for customers looking for calibration work.']
      ].map(([title,copy])=><div class="card p-6"><h2 class="text-2xl uppercase">{title}</h2><p class="mt-3 leading-7 text-zinc-400">{copy}</p></div>)}
    </div>
  </section>
  <section class="section border-y border-zinc-800 bg-[#0d0f0f]">
    <div class="container max-w-3xl">
      <p class="text-sm font-bold uppercase tracking-[.2em] text-[var(--accent)]">Need a diagnosis?</p>
      <h2 class="mt-2 text-3xl uppercase">Tell us what the car is doing.</h2>
      <p class="mt-4 leading-8 text-zinc-300">If a warning light has appeared, the battery is struggling, the air-con has stopped cooling or the car needs another electrical repair, give us the symptoms and we'll talk you through the next step.</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a class="btn btn-primary" href="/book">Book online</a>
        <a class="btn btn-secondary" href={`tel:${business.phone.replaceAll(' ','')}`}>Call {business.phone}</a>
      </div>
    </div>
  </section>
  <CTA />
</Page>
