---
import { faqs } from '../data/faq';
---
<div class="grid gap-3">
  {faqs.map((f,i)=><div class="card overflow-hidden">
    <h3><button class="faq-button flex w-full items-center justify-between p-5 text-left text-lg" aria-expanded={i===0?'true':'false'} aria-controls={`faq-${i}`}>{f.q}<span aria-hidden="true">+</span></button></h3>
    <div id={`faq-${i}`} class={i===0?'':'hidden'}><p class="border-t border-zinc-800 p-5 leading-7 text-zinc-300">{f.a}</p></div>
  </div>)}
</div>
<script is:inline>
document.querySelectorAll('.faq-button').forEach(btn=>btn.addEventListener('click',()=>{const panel=document.getElementById(btn.getAttribute('aria-controls'));const open=btn.getAttribute('aria-expanded')==='true';btn.setAttribute('aria-expanded',String(!open));panel?.classList.toggle('hidden',open)}));
</script>
