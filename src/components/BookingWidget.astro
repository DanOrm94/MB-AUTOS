---
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
---
<div class="card overflow-hidden" data-booking data-turnstile-sitekey={siteKey}>
  <div class="border-b border-zinc-800 bg-zinc-950/60 p-6">
    <div class="flex items-center justify-between gap-4">
      <div>
        <p class="text-sm font-bold uppercase tracking-[.2em] text-[var(--accent)]">Online booking</p>
        <h2 class="mt-2 text-2xl uppercase">Book your car in</h2>
      </div>
      <span class="hidden rounded-full border border-zinc-700 px-3 py-1 text-xs font-bold uppercase tracking-wider text-zinc-400 sm:inline-block">Workshop calendar</span>
    </div>
    <p class="mt-3 max-w-2xl text-zinc-400">Choose the job, pick an available day and time, then send us the request. We'll confirm the appointment with you.</p>
  </div>

  <div class="grid gap-8 p-6 lg:grid-cols-[1fr_.8fr]">
    <div class="space-y-7">
      <section>
        <p class="text-xs font-bold uppercase tracking-[.18em] text-zinc-500">1. Vehicle</p>
        <h3 class="mt-1 text-lg font-bold">What are we working on?</h3>
        <div class="mt-3 flex flex-col gap-2 sm:flex-row">
          <input class="input min-w-0 flex-1" id="booking-registration" name="registration" autocomplete="off" placeholder="AB12 CDE" aria-label="Vehicle registration" />
          <button type="button" class="btn btn-secondary shrink-0" data-lookup>Find vehicle</button>
        </div>
        <p class="mt-2 text-sm text-zinc-500" data-vehicle-status aria-live="polite"></p>
      </section>

      <section>
        <p class="text-xs font-bold uppercase tracking-[.18em] text-zinc-500">2. Job</p>
        <h3 class="mt-1 text-lg font-bold">What does it need?</h3>
        <select class="input mt-3" id="booking-service" name="service">
          <option value="">Choose a service</option>
          <option value="mot-testing">MOT</option>
          <option value="ev-servicing">EV MOT / servicing</option>
          <option value="bodywork-paintwork">Bodywork / paintwork</option>
          <option value="engine-rebuilds-timing-belts">Engine / timing belts</option>
          <option value="servicing-diagnostics">Servicing / diagnostics</option>
          <option value="brakes-tyres-clutches">Brakes / tyres / clutches</option>
        </select>
      </section>

      <section>
        <div class="flex items-end justify-between gap-4">
          <div>
            <p class="text-xs font-bold uppercase tracking-[.18em] text-zinc-500">3. Date</p>
            <h3 class="mt-1 text-lg font-bold" data-month-label></h3>
          </div>
          <div class="flex gap-2">
            <button type="button" class="btn btn-secondary !px-3 !py-2" data-prev-month aria-label="Previous month">←</button>
            <button type="button" class="btn btn-secondary !px-3 !py-2" data-next-month aria-label="Next month">→</button>
          </div>
        </div>
        <div class="mt-4 overflow-hidden rounded-xl border border-zinc-800" aria-label="Choose a booking date">
          <div class="grid grid-cols-7 border-b border-zinc-800 bg-zinc-950/70 text-center text-[10px] font-bold uppercase tracking-wider text-zinc-500">
            <span class="p-2">Mon</span><span class="p-2">Tue</span><span class="p-2">Wed</span><span class="p-2">Thu</span><span class="p-2">Fri</span><span class="p-2">Sat</span><span class="p-2">Sun</span>
          </div>
          <div class="grid grid-cols-7" data-calendar></div>
        </div>
        <p class="mt-2 text-sm text-zinc-500">Online appointments are Monday to Friday. Saturday is by appointment.</p>
      </section>

      <section>
        <p class="text-xs font-bold uppercase tracking-[.18em] text-zinc-500">4. Time</p>
        <h3 class="mt-1 text-lg font-bold">Available appointments</h3>
        <div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-3" data-slots>
          <p class="col-span-full rounded-lg border border-dashed border-zinc-800 p-4 text-sm text-zinc-500">Choose a service and date first.</p>
        </div>
      </section>
    </div>

    <div class="h-fit rounded-xl border border-zinc-800 bg-zinc-950/40 p-5 lg:sticky lg:top-24">
      <p class="text-xs font-bold uppercase tracking-[.18em] text-zinc-500">5. Your details</p>
      <h3 class="mt-1 text-lg font-bold">Send the booking request</h3>
      <div class="mt-5 grid gap-4">
        <div><label class="label" for="booking-name">Name</label><input class="input" id="booking-name" name="name" autocomplete="name" required /></div>
        <div><label class="label" for="booking-phone">Phone</label><input class="input" id="booking-phone" name="phone" autocomplete="tel" required /></div>
        <div><label class="label" for="booking-email">Email</label><input class="input" id="booking-email" name="email" type="email" autocomplete="email" required /></div>
        <div><label class="label" for="booking-notes">Anything we should know?</label><textarea class="input min-h-28" id="booking-notes" name="notes" placeholder="Optional"></textarea></div>
        <div class="cf-turnstile" data-turnstile data-sitekey={siteKey} data-callback="onTurnstileSuccess"></div>
        <button class="btn btn-primary w-full" type="button" data-book>Request appointment</button>
        <p class="text-sm" data-booking-status aria-live="polite"></p>
      </div>
    </div>
  </div>
</div>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script is:inline>
(() => {
  const root = document.querySelector('[data-booking]');
  if (!root) return;

  let turnstileToken = '';
  let selectedDate = '';
  let selectedStart = '';
  const now = new Date();
  const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
  let view = new Date(today.getFullYear(), today.getMonth(), 1);

  window.onTurnstileSuccess = (token) => { turnstileToken = token; };

  const reg = root.querySelector('[name=registration]');
  const service = root.querySelector('[name=service]');
  const calendar = root.querySelector('[data-calendar]');
  const monthLabel = root.querySelector('[data-month-label]');
  const slots = root.querySelector('[data-slots]');
  const status = root.querySelector('[data-booking-status]');
  const vehicleStatus = root.querySelector('[data-vehicle-status]');
  const book = root.querySelector('[data-book]');
  const pad = (n) => String(n).padStart(2, '0');
  const dateKey = (d) => d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
  const monthName = (d) => d.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });

  const loadSlots = async () => {
    if (!service.value || !selectedDate) return;
    selectedStart = '';
    slots.innerHTML = '<p class="col-span-full rounded-lg border border-dashed border-zinc-800 p-4 text-sm text-zinc-500">Checking workshop availability…</p>';
    try {
      const response = await fetch('/api/availability?service=' + encodeURIComponent(service.value) + '&date=' + selectedDate);
      const data = await response.json();
      slots.innerHTML = '';
      if (!response.ok || !data.slots?.length) {
        slots.innerHTML = '<p class="col-span-full rounded-lg border border-dashed border-zinc-800 p-4 text-sm text-zinc-500">No online appointments on this date. Try another day or call the workshop.</p>';
        return;
      }
      data.slots.forEach((item) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'rounded-lg border border-zinc-700 px-4 py-3 text-sm font-bold transition hover:border-[var(--accent)] hover:text-[var(--accent)]';
        button.textContent = item.label;
        button.addEventListener('click', () => {
          root.querySelectorAll('[data-slots] button').forEach((b) => b.classList.remove('border-[var(--accent)]', 'bg-[var(--accent)]/10', 'text-[var(--accent)]'));
          button.classList.add('border-[var(--accent)]', 'bg-[var(--accent)]/10', 'text-[var(--accent)]');
          selectedStart = item.start;
        });
        slots.appendChild(button);
      });
    } catch {
      slots.innerHTML = '<p class="col-span-full rounded-lg border border-dashed border-zinc-800 p-4 text-sm text-zinc-500">We could not check availability. Please call the workshop.</p>';
    }
  };

  const renderCalendar = () => {
    monthLabel.textContent = monthName(view);
    calendar.innerHTML = '';
    const first = new Date(view.getFullYear(), view.getMonth(), 1);
    const startOffset = (first.getDay() + 6) % 7;
    const days = new Date(view.getFullYear(), view.getMonth() + 1, 0).getDate();

    for (let i = 0; i < startOffset; i++) {
      const blank = document.createElement('div');
      blank.className = 'min-h-14 border-b border-r border-zinc-800/70 bg-zinc-950/20';
      calendar.appendChild(blank);
    }

    for (let day = 1; day <= days; day++) {
      const d = new Date(view.getFullYear(), view.getMonth(), day);
      const key = dateKey(d);
      const weekend = d.getDay() === 0 || d.getDay() === 6;
      const past = d < today;
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'min-h-14 border-b border-r border-zinc-800/70 p-2 text-left text-sm transition';
      if (weekend || past) {
        button.disabled = true;
        button.className += ' cursor-not-allowed text-zinc-700';
      } else {
        button.className += ' text-zinc-300 hover:bg-zinc-800 hover:text-white';
        if (key === selectedDate) button.className += ' bg-[var(--accent)]/10 text-[var(--accent)] ring-1 ring-inset ring-[var(--accent)]';
        button.addEventListener('click', () => {
          selectedDate = key;
          renderCalendar();
          loadSlots();
        });
      }
      button.textContent = day;
      calendar.appendChild(button);
    }
  };

  root.querySelector('[data-prev-month]').addEventListener('click', () => {
    const previous = new Date(view.getFullYear(), view.getMonth() - 1, 1);
    if (previous < new Date(today.getFullYear(), today.getMonth(), 1)) return;
    view = previous;
    renderCalendar();
  });

  root.querySelector('[data-next-month]').addEventListener('click', () => {
    view = new Date(view.getFullYear(), view.getMonth() + 1, 1);
    renderCalendar();
  });

  root.querySelector('[data-lookup]').addEventListener('click', async () => {
    vehicleStatus.textContent = 'Checking DVLA…';
    try {
      const response = await fetch('/api/vehicle/lookup', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ registration: reg.value }) });
      const data = await response.json();
      vehicleStatus.textContent = response.ok
        ? [data.make, data.fuel_type, data.year_of_manufacture, data.mot_status].filter(Boolean).join(' · ') || 'Vehicle found.'
        : data.error || 'Lookup failed.';
    } catch {
      vehicleStatus.textContent = 'Vehicle lookup is unavailable. You can still continue and we will check the registration.';
    }
  });

  service.addEventListener('change', loadSlots);

  book.addEventListener('click', async () => {
    const name = root.querySelector('[name=name]').value.trim();
    const phone = root.querySelector('[name=phone]').value.trim();
    const email = root.querySelector('[name=email]').value.trim();

    if (!reg.value.trim() || !service.value || !selectedDate || !selectedStart || !name || !phone || !email) {
      status.textContent = 'Please complete the vehicle, service, date, time and contact details.';
      return;
    }
    if (!turnstileToken) {
      status.textContent = 'Please complete the security check before sending.';
      return;
    }

    book.disabled = true;
    status.textContent = 'Sending booking request…';

    try {
      const response = await fetch('/api/bookings', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          registration: reg.value,
          service: service.value,
          start: selectedStart,
          name,
          phone,
          email,
          notes: root.querySelector('[name=notes]').value.trim(),
          turnstileToken
        })
      });
      const data = await response.json();
      if (!response.ok) {
        status.textContent = data.error || 'That slot is no longer available. Please choose another.';
        book.disabled = false;
        return;
      }
      status.textContent = 'Booking request received — we’ll confirm the appointment with you.';
      book.textContent = 'Request sent';
    } catch {
      status.textContent = 'We could not send the booking request. Please call the workshop.';
      book.disabled = false;
    }
  });

  renderCalendar();
})();
</script>
