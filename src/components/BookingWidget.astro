<div class="card p-6" data-booking>
  <div class="grid gap-5">
    <div><label class="label" for="booking-registration">Vehicle registration</label><div class="flex gap-2"><input class="input min-w-0 flex-1" id="booking-registration" name="registration" autocomplete="off" placeholder="AB12 CDE" /><button type="button" class="btn btn-secondary" data-lookup>Find vehicle</button></div><p class="mt-2 text-sm text-zinc-500" data-vehicle-status aria-live="polite"></p></div>
    <div class="grid gap-4 sm:grid-cols-2"><div><label class="label" for="booking-service">Service</label><select class="input" id="booking-service" name="service"><option value="">Choose a service</option><option value="mot-testing">MOT</option><option value="ev-servicing">EV MOT / servicing</option><option value="bodywork-paintwork">Bodywork / paintwork</option><option value="engine-rebuilds-timing-belts">Engine / timing belts</option><option value="servicing-diagnostics">Servicing / diagnostics</option><option value="brakes-tyres-clutches">Brakes / tyres / clutches</option></select></div><div><label class="label" for="booking-date">Date</label><input class="input" id="booking-date" type="date" name="date" /></div></div>
    <div><label class="label" for="booking-slot">Available appointment</label><select class="input" id="booking-slot" name="slot" disabled><option>Select a service and date</option></select></div>
    <div class="grid gap-4 sm:grid-cols-2"><div><label class="label" for="booking-name">Name</label><input class="input" id="booking-name" name="name" autocomplete="name" required /></div><div><label class="label" for="booking-phone">Phone</label><input class="input" id="booking-phone" name="phone" autocomplete="tel" required /></div></div>
    <div><label class="label" for="booking-email">Email</label><input class="input" id="booking-email" name="email" type="email" autocomplete="email" required /></div>
    <div><label class="label" for="booking-notes">Anything we should know?</label><textarea class="input min-h-28" id="booking-notes" name="notes"></textarea></div>
    <p class="text-sm text-zinc-400">Saturday is by appointment. For Saturday or urgent jobs, call the workshop.</p>
    <button class="btn btn-primary" type="button" data-book>Request appointment</button>
    <p class="text-sm" data-booking-status aria-live="polite"></p>
  </div>
</div>
<script is:inline>
(()=>{const r=document.querySelector('[data-booking]');if(!r)return;const reg=r.querySelector('[name=registration]'),svc=r.querySelector('[name=service]'),date=r.querySelector('[name=date]'),slot=r.querySelector('[name=slot]'),status=r.querySelector('[data-booking-status]'),vs=r.querySelector('[data-vehicle-status]');const load=async()=>{if(!svc.value||!date.value)return;slot.disabled=true;slot.innerHTML='<option>Checking availability…</option>';const x=await fetch('/api/availability?service='+encodeURIComponent(svc.value)+'&date='+date.value),d=await x.json();slot.innerHTML='<option value="">Choose a time</option>';(d.slots||[]).forEach(s=>{const o=document.createElement('option');o.value=s.start;o.textContent=s.label;slot.appendChild(o)});if(!d.slots?.length){slot.innerHTML='<option>No online slots — call us.</option>';slot.disabled=true}else slot.disabled=false};r.querySelector('[data-lookup]').addEventListener('click',async()=>{vs.textContent='Checking…';const x=await fetch('/api/vehicle/lookup',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({registration:reg.value})}),d=await x.json();vs.textContent=x.ok?[d.make,d.fuel_type,d.year_of_manufacture,d.mot_status].filter(Boolean).join(' · '):d.error||'Lookup failed.'});svc.addEventListener('change',load);date.addEventListener('change',load);r.querySelector('[data-book]').addEventListener('click',async()=>{status.textContent='Sending…';const p={registration:reg.value,service:svc.value,start:slot.value,name:r.querySelector('[name=name]').value,phone:r.querySelector('[name=phone]').value,email:r.querySelector('[name=email]').value,notes:r.querySelector('[name=notes]').value};const x=await fetch('/api/bookings',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(p)}),d=await x.json();status.textContent=x.ok?'Booking request received — we’ll confirm it with you.':d.error||'Please call the workshop.'})})();
</script>
